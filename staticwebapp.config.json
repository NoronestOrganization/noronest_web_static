{
  "routes": [
    {
      "route": "/doktor/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/doktor/*.png",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/doktor",
      "rewrite": "/doktor/index.html"
    },
    {
      "route": "/doktor/*",
      "rewrite": "/doktor/index.html"
    },
    {
      "route": "/app/*",
      "rewrite": "/app/index.html"
    },
    {
      "route": "/games/*.unityweb",
      "headers": {
        "Content-Encoding": "br",
        "Content-Type": "application/octet-stream"
      }
    },
    {
      "route": "/unitygames/*.unityweb",
      "headers": {
        "Content-Encoding": "br",
        "Content-Type": "application/octet-stream"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/app/index.html",
    "exclude": ["/unitygames/*", "/img/*", "/icons/*", "/games/*", "/doktor/*", "/public/*", "/*.png"]
  },
  "mimeTypes": {
    ".unityweb": "application/octet-stream"
  }
}
